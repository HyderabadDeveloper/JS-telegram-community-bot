{
  "name": "telegram-community-bot",
  "version": "1.0.0",
  "private": true,
  "description": "A friendly Telegram group bot for welcomes, moderation, and AI-powered help.",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "dev:worker": "wrangler dev",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "secrets:upload": "node scripts/cloudflare.js secrets",
    "webhook:set": "node scripts/cloudflare.js webhook"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "groq-sdk": "^1.6.0"
  }
}
