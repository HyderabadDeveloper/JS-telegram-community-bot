TELEGRAM_BOT_TOKEN=replace_with_botfather_token

# Optional AI support. The endpoint is OpenAI-compatible.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Comma-separated words or phrases that should be treated as spam.
SPAM_TERMS=free crypto,airdrop,click here,make money fast

# Set both to enable webhooks. Leave WEBHOOK_URL empty for long polling.
WEBHOOK_URL=
WEBHOOK_SECRET=

# HTTP port for health checks and webhooks. Set to 0 only in polling mode.
PORT=3000

# Keep replies concise and community-focused.
AI_SYSTEM_PROMPT=You are a helpful, friendly assistant in a Telegram community. Answer questions clearly and briefly. Encourage respectful sharing, do not invent facts, and suggest trusted sources when unsure.
